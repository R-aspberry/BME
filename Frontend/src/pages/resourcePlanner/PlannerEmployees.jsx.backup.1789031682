import React, { useEffect, useMemo, useState } from 'react'
import { createOSE, getOSEmployees, updateOSE } from '../../services/oseService'
import { getResourcePlanners } from '../../services/resourcePlannerService'

const emptyForm = { OSE_ID: '', FN: '', LN: '', Vendor: '', Email: '', Phone: '', Status: 'Selected', Planner_ID: '', Interviewer_ID: 1, User_ID: '', EMP_ID: 1, age: '', skills: '', title: '' }
const statuses = ['Selected', 'In Interview', 'Hired', 'Rejected']
const statusClass = status => ({ Hired: 'aaib-badge-success', Selected: 'aaib-badge-warning', 'In Interview': 'aaib-badge-neutral', Rejected: 'aaib-badge-danger' }[status] || 'aaib-badge-neutral')

export default function PlannerEmployees() {
  const [employees, setEmployees] = useState([])
  const [planners, setPlanners] = useState([])
  const [form, setForm] = useState(emptyForm)
  const [editingId, setEditingId] = useState(null)
  const [query, setQuery] = useState('')
  const [message, setMessage] = useState('')
  const [error, setError] = useState('')
  const [showForm, setShowForm] = useState(false)

  async function load() { const [ose, plannerData] = await Promise.all([getOSEmployees(), getResourcePlanners()]); setEmployees(ose || []); setPlanners(plannerData || []) }
  useEffect(() => { load().catch(() => setError('Unable to load the OS employee pipeline.')) }, [])
  const visible = useMemo(() => employees.filter(item => `${item.fN || ''} ${item.lN || ''} ${item.vendor || ''}`.toLowerCase().includes(query.toLowerCase())), [employees, query])
  function openCreate() { setEditingId(null); setForm({ ...emptyForm, Planner_ID: planners[0]?.planner_ID || '' }); setError(''); setShowForm(true) }
  function openEdit(item) { setEditingId(item.ose_ID); setForm({ ...emptyForm, ...item, OSE_ID: item.ose_ID, FN: item.fN, LN: item.lN, Vendor: item.vendor, Planner_ID: item.planner_ID, Interviewer_ID: item.interviewer_ID || 1, EMP_ID: item.emp_ID || 1, User_ID: item.user_ID || '' }); setError(''); setShowForm(true) }
  async function submit(event) { event.preventDefault(); setError(''); setMessage(''); const payload = { OSE_ID: Number(form.OSE_ID), FN: form.FN, LN: form.LN, Age: form.Age ? Number(form.Age) : null, Skills: form.Skills, Title: form.Title, Vendor: form.Vendor, Email: form.Email, Phone: form.Phone, Status: form.Status, Planner_ID: Number(form.Planner_ID), Interviewer_ID: Number(form.Interviewer_ID), User_ID: form.User_ID ? Number(form.User_ID) : null, EMP_ID: Number(form.EMP_ID) }; try { if (editingId) await updateOSE(editingId, payload); else await createOSE(payload); await load(); setShowForm(false); setMessage(editingId ? 'OS employee updated.' : 'OS employee added to the pipeline.') } catch { setError('The API could not save this OS employee. Check required IDs and database relationships.') } }
  return <div className="planner-content aaib-animate-fade"><div className="planner-page-head"><div><p className="planner-eyebrow">TALENT PIPELINE</p><h1>OS employees</h1><p>Review, add, and move candidates through the hiring pipeline.</p></div><button className="aaib-btn aaib-btn-primary" onClick={openCreate}>+ Add OS employee</button></div>{message && <div className="planner-feedback success">{message}</div>}{error && <div className="planner-feedback error">{error}</div>}<div className="planner-toolbar"><input className="aaib-input" placeholder="Search name or vendor" value={query} onChange={event => setQuery(event.target.value)} /><div className="planner-status-legend">{statuses.map(status => <span key={status}><i className={`legend-dot ${statusClass(status)}`} />{status}</span>)}</div></div><div className="planner-table-wrap aaib-panel"><table className="planner-table"><thead><tr><th>Candidate</th><th>Age</th><th>Title / skills</th><th>Vendor</th><th>Status</th><th>Planner</th><th>Actions</th></tr></thead><tbody>{visible.map(item => <tr key={item.ose_ID}><td><strong>{item.fN} {item.lN}</strong><small>{item.email || 'Email not provided'}</small></td><td>{item.age || '—'}</td><td><strong>{item.title || '—'}</strong><small>{item.skills || 'Skills not provided'}</small></td><td>{item.vendor || '—'}</td><td><span className={`aaib-badge ${statusClass(item.status)}`}>{item.status || 'Selected'}</span></td><td>PLN-{item.planner_ID}</td><td><button className="planner-table-action" onClick={() => openEdit(item)}>Edit</button></td></tr>)}</tbody></table>{!visible.length && <div className="planner-empty">No OS employees match this view.</div>}</div>{showForm && <div className="planner-modal-backdrop"><form className="aaib-panel planner-form" onSubmit={submit}><div className="planner-form-head"><div><p className="planner-eyebrow">PIPELINE RECORD</p><h2>{editingId ? 'Edit OS employee' : 'Add OS employee'}</h2></div><button type="button" className="planner-close" onClick={() => setShowForm(false)}>×</button></div><div className="planner-form-grid"><label>First name<input className="aaib-input" required value={form.FN} onChange={event => setForm({ ...form, FN: event.target.value })} /></label><label>Last name<input className="aaib-input" required value={form.LN} onChange={event => setForm({ ...form, LN: event.target.value })} /></label><label>Age<input className="aaib-input" type="number" min="18" max="100" value={form.Age || ''} onChange={event => setForm({ ...form, Age: event.target.value })} /></label><label>Title<input className="aaib-input" value={form.Title || ''} onChange={event => setForm({ ...form, Title: event.target.value })} /></label><label className="planner-form-wide">Skills<input className="aaib-input" value={form.Skills || ''} onChange={event => setForm({ ...form, Skills: event.target.value })} /></label><label>Vendor<input className="aaib-input" value={form.Vendor} onChange={event => setForm({ ...form, Vendor: event.target.value })} /></label><label>Email<input className="aaib-input" type="email" value={form.Email} onChange={event => setForm({ ...form, Email: event.target.value })} /></label><label>Phone<input className="aaib-input" value={form.Phone} onChange={event => setForm({ ...form, Phone: event.target.value })} /></label><label>Status<select className="aaib-select" value={form.Status} onChange={event => setForm({ ...form, Status: event.target.value })}>{statuses.map(status => <option key={status}>{status}</option>)}</select></label><label>Planner<select className="aaib-select" required value={form.Planner_ID} onChange={event => setForm({ ...form, Planner_ID: event.target.value })}>{planners.map(planner => <option key={planner.planner_ID} value={planner.planner_ID}>{planner.name} · PLN-{planner.planner_ID}</option>)}</select></label><label>OSE ID<input className="aaib-input" type="number" required value={form.OSE_ID} onChange={event => setForm({ ...form, OSE_ID: event.target.value })} /></label><label>Employee ID<input className="aaib-input" type="number" required value={form.EMP_ID} onChange={event => setForm({ ...form, EMP_ID: event.target.value })} /></label></div><p className="planner-form-note">Age, skills, and title are now persisted through the OSE API.</p><div className="planner-form-actions"><button type="button" className="aaib-btn aaib-btn-secondary" onClick={() => setShowForm(false)}>Cancel</button><button className="aaib-btn aaib-btn-primary">{editingId ? 'Save employee' : 'Add employee'}</button></div></form></div>}</div>
}
